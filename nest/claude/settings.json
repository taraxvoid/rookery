{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch -c agent/*)",
      "Bash(git switch agent/*)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git pull --ff-only)",
      "Bash(git restore --staged *)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit * --add-label *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create --draft *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *:*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD*)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit *--amend*)",
      "Bash(git -c *)",
      "Bash(git config *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git update-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git gc *)",
      "Bash(git prune*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git switch -C *)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh release delete *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)"
    ]
  }
}

{
  "$schema": "https://app.kilo.ai/config.json",
  // Tier-0 bird. Mirrors ../agents/kingfisher.md's tools:
  // Read, Grep, Glob, WebFetch.
  // Model: Nvidia Nemotron 3 Nano Omni 30B-A3B "reasoning" (free tier) —
  // reasoning-tuned, favors precision over breadth for a fixed-target dive.
  // Picked from the live openrouter.ai/api/v1/models catalog, 2026-09-10.
  "model": "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
  "provider": {
    "openrouter": { "env": ["OPENROUTER_API_KEY_TIER0"] }
  },
  "instructions": ["../agents/kingfisher.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "edit": "deny",
    "bash": "deny",
    "external_directory": "deny",
    "task": "deny",
    "agent_manager": "deny",
    "skill": "deny",
    "todowrite": "deny",
    "websearch": "deny",
    "webfetch": "allow",
    "doom_loop": "deny"
  },
  "sandbox": {
    "enabled": true,
    "network": "deny",
    "allowed_hosts": [],
    "writable_paths": []
  }
}

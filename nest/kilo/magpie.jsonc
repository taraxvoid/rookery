{
  "$schema": "https://app.kilo.ai/config.json",
  // Tier-0 bird. Mirrors ../agents/magpie.md's tools: Read, Grep, Glob.
  // Model: Google Gemma 4 31B-IT (free tier, open-weight) — solid general
  // reasoning for small investigations, no cost. Picked from the live
  // openrouter.ai/api/v1/models catalog, 2026-09-10.
  "model": "openrouter/google/gemma-4-31b-it:free",
  "provider": {
    "openrouter": { "env": ["OPENROUTER_API_KEY_TIER0"] }
  },
  "instructions": ["../agents/magpie.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "edit": "deny",
    "bash": "deny",
    "external_directory": "deny",
    "task": "deny",
    "agent_manager": "deny",
    "skill": "deny",
    "todowrite": "deny",
    "websearch": "deny",
    "webfetch": "deny",
    "doom_loop": "deny"
  },
  "sandbox": {
    "enabled": true,
    "network": "deny",
    "writable_paths": []
  }
}

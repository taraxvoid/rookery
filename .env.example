# OpenRouter keys, one per tier. Preferred: leave these empty.
# `nest/spend.py apply` creates the keys straight into the OS keychain and
# `nest/spend.py env` loads them into a shell. This file is for setups without
# a keychain. Limits and model allowlists live in nest/spend.toml.

# Tier 0: free or near-free models only.
OPENROUTER_API_KEY_TIER0=

# Tier 1 and up (crow, raven, vixen), plus jackdaw: read-only, but a paid
# non-Claude reasoning model.
OPENROUTER_API_KEY_TIER1=
